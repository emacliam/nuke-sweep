{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]},
    {"source":"/downloads/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=3600"}]},
    {"source":"/downloads/(.*).dmg","headers":[{"key":"Content-Type","value":"application/x-apple-diskimage"},{"key":"Content-Disposition","value":"attachment"}]}
  ]
}
