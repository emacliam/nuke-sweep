<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Plural rules.

  The app previously pluralised with `count == 1 ? "" : "s"`, which is correct
  for English and wrong for most other languages: Polish has three plural
  categories, Arabic six, and Japanese none. A ternary cannot express that, and
  a translator cannot fix it from the catalogue.

  Each entry below names a format key used with `String(format: String(localized:))`.
  Translators add the categories their language needs; English only needs `one`
  and `other`.
-->
<plist version="1.0">
<dict>
  <key>%lld items</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>1 item</string>
      <key>other</key>
      <string>%lld items</string>
    </dict>
  </dict>

  <key>%lld locations</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>1 location</string>
      <key>other</key>
      <string>%lld locations</string>
    </dict>
  </dict>

  <key>%lld projects</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>1 project</string>
      <key>other</key>
      <string>%lld projects</string>
    </dict>
  </dict>

  <key>%lld copies</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>1 copy</string>
      <key>other</key>
      <string>%lld copies</string>
    </dict>
  </dict>

  <key>%lld other locations</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>1 other location</string>
      <key>other</key>
      <string>%lld other locations</string>
    </dict>
  </dict>

  <key>%lld items held back</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>1 item held back as protected, source-like, or not completely measured. It stays out of the shortlist and cannot be selected from it.</string>
      <key>other</key>
      <string>%lld items held back as protected, source-like, or not completely measured. They stay out of the shortlist and cannot be selected from it.</string>
    </dict>
  </dict>

  <key>%lld areas measured</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key>
    <string>%#@count@</string>
    <key>count</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key>
      <string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key>
      <string>lld</string>
      <key>one</key>
      <string>1 area measured</string>
      <key>other</key>
      <string>%lld areas measured</string>
    </dict>
  </dict>
</dict>
</plist>
